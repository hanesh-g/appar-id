# Copy with scripts/configure_local.py; do not commit your real .env.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://apaar_app:CHANGE_ME@localhost:5432/apaar
TEST_DATABASE_URL=postgresql+psycopg://apaar_app:CHANGE_ME@localhost:5432/apaar_test
JWT_SECRET=GENERATE_A_RANDOM_SECRET
PII_KEY=GENERATE_A_BASE64_32_BYTE_KEY
HMAC_KEY=GENERATE_A_BASE64_32_BYTE_KEY
JWT_ISSUER=apaar-demo
JWT_AUDIENCE=apaar-web
ALLOWED_ORIGINS=http://localhost:5173
REGISTRY_MODE=mock
MOCK_REGISTRY_OUTAGE=false
DEMO_PASSWORD=CHOOSE_YOUR_LOCAL_DEMO_PASSWORD
LOCAL_DB_PASSWORD=CHANGE_ME
